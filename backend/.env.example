# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@127.0.0.1:5432/setu

# --- Secrets ---------------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETU_SECRET_KEY=

# --- Web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Behaviour -------------------------------------------------------------
USE_PLACEHOLDER_AI=true

# --- Model (Google Gemini via ADK's native Gemini integration + GitHub's ---
# --- hosted MCP server) -----------------------------------------------------
# GEMINI_MODEL is the one place to change which model the agents run on.
# Get a key from Google AI Studio (aistudio.google.com/apikey) and set it in
# GEMINI_API_KEY; left blank, the google-genai client reads a GEMINI_API_KEY
# already in the environment instead.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# minimal | low | medium | high. The chat's live progress lines come from the
# model's thought summaries, which only appear at medium or above. Higher is
# slower and costs more per turn; blank keeps the model's default.
GEMINI_THINKING_LEVEL=medium

# Fine-grained GitHub personal access token, scoped to exactly ONE repository
# (GitHub -> Settings -> Developer settings -> Fine-grained tokens). Grant it
# read-only access to Contents, Issues, Pull requests and Metadata for that
# repository only -- the token's scope is what limits the agent, not the code.
GITHUB_PAT=
# "owner/repo" the PAT above is actually scoped to, e.g. "acme/api". Agents
# are told this directly so they don't waste turns guess-searching GitHub by
# a project's display name, which may not match the repo's real slug.
GITHUB_REPO=
# Branch every read is scoped to. Blank = the repo's default branch. Set it
# when the code and the .agent/context.yaml map live on a non-default branch.
GITHUB_BRANCH=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Flip to false only once the token is deliberately given write scopes too.
GITHUB_MCP_READONLY=true
# "all" (21 toolsets) makes every request's tool-schema payload huge before
# any real content -- GitHub's own curated "default" (context, repos, issues,
# pull_requests, users) already covers what these agents need.
GITHUB_MCP_TOOLSETS=default