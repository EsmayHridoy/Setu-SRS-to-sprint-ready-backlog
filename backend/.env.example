# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:123456789@127.0.0.1:5433/setu

# --- Secrets ---------------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETU_SECRET_KEY=

# --- Web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Behaviour -------------------------------------------------------------
USE_PLACEHOLDER_AI=true
SEED_ON_START=false

# --- GitHub agent (Gemini ADK + GitHub's hosted MCP server) ----------------
# Gemini API key for the ADK agent. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fine-grained GitHub personal access token, scoped to exactly ONE repository
# (GitHub -> Settings -> Developer settings -> Fine-grained tokens). Grant it
# read-only access to Contents, Issues, Pull requests and Metadata for that
# repository only -- the token's scope is what limits the agent, not the code.
GITHUB_PAT=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Flip to false only once the token is deliberately given write scopes too.
GITHUB_MCP_READONLY=true