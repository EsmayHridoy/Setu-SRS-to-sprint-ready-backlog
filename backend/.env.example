# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@127.0.0.1:5432/setu

# --- Secrets ---------------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETU_SECRET_KEY=

# --- Web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Behaviour -------------------------------------------------------------
USE_PLACEHOLDER_AI=true
SEED_ON_START=false

# --- GitHub agent (local Ollama via LiteLLM + ADK + GitHub's hosted MCP server) ----
# Must be pulled and running locally first: `ollama pull devstral:24b`.
# No API key -- Ollama is local and unauthenticated.
OLLAMA_MODEL=devstral:24b
OLLAMA_API_BASE=http://localhost:11434

# Fine-grained GitHub personal access token, scoped to exactly ONE repository
# (GitHub -> Settings -> Developer settings -> Fine-grained tokens). Grant it
# read-only access to Contents, Issues, Pull requests and Metadata for that
# repository only -- the token's scope is what limits the agent, not the code.
GITHUB_PAT=
# "owner/repo" the PAT above is actually scoped to, e.g. "acme/api". Agents
# are told this directly so they don't waste turns guess-searching GitHub by
# a project's display name, which may not match the repo's real slug.
GITHUB_REPO=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Flip to false only once the token is deliberately given write scopes too.
GITHUB_MCP_READONLY=true
# "all" (21 toolsets) makes every request's tool-schema payload huge before
# any real content -- GitHub's own curated "default" (context, repos, issues,
# pull_requests, users) already covers what these agents need.
GITHUB_MCP_TOOLSETS=default